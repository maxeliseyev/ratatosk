<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Local SOCKS5/HTTP proxy only (no TUN), as a per-user launchd agent.

  Preferred: `ratatosk service install -f server.txt` generates and loads this for you.
  Manual way:

  install:
    mkdir -p ~/.config/ratatosk && cp config.toml ~/.config/ratatosk/config.toml
    sed "s#HOME#$HOME#g" docs/launchd/com.ratatosk.local.plist > ~/Library/LaunchAgents/com.ratatosk.local.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.ratatosk.local.plist
  stop / remove:
    launchctl bootout gui/$(id -u)/com.ratatosk.local
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ratatosk.local</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/ratatosk</string>
    <string>--config</string>
    <string>HOME/.config/ratatosk/config.toml</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>HOME/Library/Logs/ratatosk.log</string>
  <key>StandardErrorPath</key><string>HOME/Library/Logs/ratatosk.log</string>
</dict>
</plist>
